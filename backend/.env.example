# Copy this file to .env and fill in your own values. Never commit .env.
# Example: cp .env.example .env

# Port the backend listens on
PORT=5000

# MongoDB Atlas connection string (leave empty to run without a database;
# the server still starts and tracking endpoints return a graceful response)
# Example format (do NOT paste a real password here):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/github-user-finder
MONGODB_URI=

# Secret used to sign admin JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Admin account created ONLY by the seed script (npm run seed:admin).
# There is no public admin registration route.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
